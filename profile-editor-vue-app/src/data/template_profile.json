    "right_backward_slow": {
      "mode": "keyboard",
      "keycode": "S",
      "action": "multitap",
      "value": 4
    },
    "right_backward_fast": {
      "mode": "keyboard",
      "keycode": "W",
      "action": "multitap",
      "value": 4

    "add_speed": {
      "mode": "keyboard",
      "keycode": "A",
      "action": "toggle"
    },
    "slow_down": {
      "mode": "keyboard",
      "keycode": "S",
      "action": "tap",
      "value": 0,
      "analog_value": 0
    },
    "stop": {
      "mode": "keyboard",
      "keycode": "X",
      "action": "tap"
    },
    "reverse": {
      "mode": "keyboard",
      "keycode": "S",
      "action": "tap",
      "value": 0,
      "analog_value": 0
    },
    "after_reverse": {
      "mode": "keyboard",
      "keycode": "S",
      "action": "tap"
    },
    "jump": {
      "mode": "keyboard",
      "keycode": "SPACE",
      "action": "tap"
